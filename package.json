{
  "name": "cadans",
  "private": true,
  "version": "0.1.0",
  "description": "Cadans — FHIR-native huisartsinformatiesysteem voor teamgebaseerde, persoonsgerichte eerstelijnszorg",
  "license": "UNLICENSED",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "npm run build && node --test packages/*/test/*.test.js",
    "api": "npm run build && node apps/api/dist/server.js",
    "web": "npm --workspace @zpe/web run dev",
    "dev": "npm run build && concurrently -n api,web -c blue,magenta \"node apps/api/dist/server.js\" \"npm --workspace @zpe/web run dev\""
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
